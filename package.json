{
  "name": "utilora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run seo:generate && vite build && npm run prerender",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:core": "tsx scripts/test-local-core.ts",
    "seo:generate": "tsx scripts/generate-seo-files.ts",
    "prerender": "tsx scripts/prerender-routes.tsx",
    "test:pdf": "tsx scripts/test-pdf-core.ts",
    "test:image": "tsx scripts/test-image-core.ts",
    "test:diagnostics": "tsx --test src/tests/diagnostics.test.ts",
    "e2e": "playwright test",
    "test:products": "tsx --test src/tests/tool-experience.test.ts",
    "test:registry": "tsx --test src/tests/registry.test.ts",
    "test:agent-config": "tsx scripts/test-agent-config.ts",
    "test:opencode-smoke": "python3 -m unittest discover -s scripts -p 'test_opencode_smoke.py'"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "mediabunny": "1.65.0",
    "@mediabunny/mp3-encoder": "1.62.1",
    "@mediabunny/aac-encoder": "1.65.0",
    "html-to-image": "1.11.13",
    "posthog-js": "^1.444.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
