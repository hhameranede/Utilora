{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": true,
      "timeout": 60000
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false,
      "timeout": 60000
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp",
      "enabled": false,
      "timeout": 60000
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": "deny",
    "read": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "playwright_*": "allow",
    "context7_*": "allow",
    "firecrawl_*": "allow",
    "cloudflare-docs_*": "allow",
    "cloudflare-api_*": "ask",
    "posthog_*": "ask"
  },
  "default_agent": "project-lead",
  "provider": {
    "nvidia-nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "nemotron-ultra": {
          "id": "nvidia/nemotron-3-ultra-550b-a55b",
          "name": "Nemotron 3 Ultra 550B",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "deepseek-v4-1-flash": {
          "id": "deepseek-ai/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "minimax-m3-1-flash": {
          "id": "minimaxai/minimax-m3.1-flash",
          "name": "MiniMax M3.1 Flash",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        },
        "glm-5-3-flash": {
          "id": "z-ai/glm-5.3-flash",
          "name": "GLM 5.3 Flash",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        },
        "nemotron-super-vl": {
          "id": "nvidia/nemotron-3.5-super-vl-120b-a12b",
          "name": "Nemotron 3.5 Super VL 120B",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "laguna-xs-2-1": {
          "id": "poolside/laguna-xs-2.1",
          "name": "Poolside Laguna XS 2.1",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    }
  }
}
